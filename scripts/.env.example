# ─────────────────────────────────────────────────────────────────────────────
#  AI-Clinic data seeder — configuration
#  Copy this file to `.env` and adjust as needed:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Target server ────────────────────────────────────────────────────────────
# Base URL of the running backend (no trailing slash).
SERVER_URL=http://localhost:8080

# Superadmin credentials — used to manage roles and verify doctors.
# These must match the server's seeded superuser (SUPERUSER_EMAIL/PASSWORD).
ADMIN_EMAIL=admin@ai-clinic.com
ADMIN_PASSWORD=SuperAdmin123!

# ── How many of each role to create ──────────────────────────────────────────
PATIENT_COUNT=80
DOCTOR_COUNT=20
NURSE_COUNT=30

# Each doctor is assigned a random number of nurses in this inclusive range.
# (Every nurse is guaranteed to be assigned to at least one doctor.)
NURSES_PER_DOCTOR_MIN=1
NURSES_PER_DOCTOR_MAX=3

# ── Rich seeding toggles ─────────────────────────────────────────────────────
# Create full doctor profiles (specialty, visit methods, etc). Required for
# nurse assignment, so this is forced on when NURSE_COUNT > 0.
CREATE_DOCTOR_PROFILES=true
# Admin-verify doctor profiles so they appear in public doctor listings.
VERIFY_DOCTORS=true
# Create patient medical profiles (history, allergies, medications, ...).
CREATE_PATIENT_PROFILES=true

# ── Identity randomization ───────────────────────────────────────────────────
# Domain used to build e-mail addresses (user@EMAIL_DOMAIN).
EMAIL_DOMAIN=seed.aiclinic.local
# Generated password length (min 8; always contains upper+lower+digit).
PASSWORD_LENGTH=12
# Seed for the RNG. 0 = time-based (non-reproducible); any other value makes
# the whole run reproducible.
RANDOM_SEED=0

# ── Execution ────────────────────────────────────────────────────────────────
# Max concurrent in-flight HTTP requests per phase.
CONCURRENCY=10
# Per-request timeout in seconds.
REQUEST_TIMEOUT_SEC=30
# Retries on 429 / 5xx (exponential backoff). Lets the seeder survive rate
# limiting if APP_ENV=production on the server.
MAX_RETRIES=6

# Directory to write the output files into. Default: same folder as the script.
OUTPUT_DIR=.
